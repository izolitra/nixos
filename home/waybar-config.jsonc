{
  "layer": "top",
  "position": "top",
  "height": 40,
  "spacing": 6,
  "margin-top": 8,
  "margin-left": 10,
  "margin-right": 10,

  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["hyprland/language", "network", "pulseaudio", "cpu", "memory", "tray"],

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "sort-by-number": true
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 55,
    "separate-outputs": true
  },

  "hyprland/language": {
    "format": "{}",
    "format-en": "EN",
    "format-ru": "RU",
    "tooltip-format": "{long}"
  },

  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%A, %d %B  %H:%M}",
    "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
  },

  "network": {
    "format-wifi": "Wi-Fi  {essid}",
    "format-ethernet": "Ethernet",
    "format-linked": "Сеть",
    "format-disconnected": "Нет сети",
    "tooltip-format-wifi": "{essid}\nСигнал: {signalStrength}%\n{ipaddr}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
    "tooltip-format-disconnected": "Сеть отключена"
  },

  "pulseaudio": {
    "format": "Звук  {volume}%",
    "format-muted": "Без звука",
    "scroll-step": 5,
    "on-click": "pavucontrol"
  },

  "cpu": {
    "format": "CPU {usage}%",
    "interval": 3,
    "tooltip": false
  },

  "memory": {
    "format": "RAM {percentage}%",
    "interval": 3,
    "tooltip-format": "Использовано {used:0.1f} ГБ из {total:0.1f} ГБ"
  },

  "tray": {
    "icon-size": 17,
    "spacing": 9
  }
}
